---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Alle projekter | Celina Sguazzino"
  description="Se alle projekter af Celina Sguazzino inden for digitalt design, branding, fotografi og webudvikling."
>
  <div class="min-h-screen bg-background">
    <Navigation />
    <main>
      <div>
        <a
          href="/"
          data-back-link="/"
          class="inline-flex items-center gap-2 border-b border-primary pb-1 font-sans text-sm text-primary transition-colors hover:border-primary/60 hover:text-primary/70"
        >
          <span aria-hidden="true">←</span>
          <span data-i18n="project.backToHome">Tilbage til forsiden</span>
        </a>
      </div>
      <ProjectsSection
        headingKey="projects.allHeading"
        headingText="alle projekter"
        containerClass="!max-w-7xl !pt-4 md:!pt-20"
        wideLayout
        compactLayout
      />
    </main>
    <Footer />
  </div>
</Layout>

<script>
  const backLink = document.querySelector<HTMLAnchorElement>("[data-back-link]");

  if (backLink) {
    const referrer = document.referrer;
    const currentOrigin = window.location.origin;
    const cameFromHome =
      referrer.startsWith(`${currentOrigin}/`) &&
      new URL(referrer).pathname === "/";

    backLink.addEventListener("click", (event) => {
      if (!cameFromHome || window.history.length <= 1) return;

      event.preventDefault();
      window.history.back();
    });
  }
</script>
