---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { getProjectBySlug, projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = slug ? getProjectBySlug(slug) : undefined;

if (!project) {
  return Astro.redirect("/");
}

const isNordicHairGlow = project.slug === "nordic-hair-glow";
---

<Layout title={`${project.title} | Celina Sguazzino`}>
  <div class="min-h-screen bg-background">

    <Navigation />

    <main
      class:list={[
        "min-h-screen px-4 md:px-6 lg:px-8 pb-24",
        isNordicHairGlow
          ? "pt-0"
          : "pt-24 md:pt-28",
      ]}
    >

      <div class="max-w-7xl mx-auto">

        {
          isNordicHairGlow ? (

            <!-- ================================================= -->
            <!-- NORDIC HAIR GLOW -->
            <!-- ================================================= -->

            <section
              class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start"
            >

              <!-- LEFT — NORDIC CONTENT -->

              <div class="order-2 lg:order-1">

                <div class="mt-24 mb-10">

                  <a
                    href="/#projects"
                    class="inline-flex items-center gap-2 font-sans text-sm text-muted-foreground hover:text-primary transition-colors"
                  >
                    <span aria-hidden="true">←</span>
                    Back to projects
                  </a>

                </div>


                <!-- 01 META ADS -->

                <section
                  id="meta-ads"
                  class="mb-32"
                >

                  <div class="mb-8">

                    <p class="project-number">
                      01
                    </p>

                    <h2 class="project-heading">
                      Meta Ads
                    </h2>

                  </div>


                  <div class="grid grid-cols-2 gap-4">

                    <figure class="col-span-2 bg-black overflow-hidden">

                      <video
                        controls
                        preload="metadata"
                        class="block w-full aspect-video object-cover"
                      >
                        <source
                          src="/videos/nordic-meta-ads.mp4"
                          type="video/mp4"
                        />
                      </video>

                    </figure>


                    <figure>

                      <img
                        src="/images/nordic-hair-glow/meta-ad-01.jpg"
                        alt="Nordic Hair Glow Meta advertisement"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="mt-12">

                      <img
                        src="/images/nordic-hair-glow/meta-ad-02.jpg"
                        alt="Nordic Hair Glow Meta advertisement"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="col-span-2">

                      <img
                        src="/images/nordic-hair-glow/meta-ad-03.jpg"
                        alt="Nordic Hair Glow advertising creative"
                        loading="lazy"
                        class="w-full h-auto object-cover"
                      />

                    </figure>


                    <figure>

                      <img
                        src="/images/nordic-hair-glow/meta-ad-04.jpg"
                        alt="Nordic Hair Glow Meta advertisement"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="mt-12">

                      <img
                        src="/images/nordic-hair-glow/meta-ad-05.jpg"
                        alt="Nordic Hair Glow Meta advertisement"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>

                  </div>

                </section>


                <!-- 02 WEB DESIGN -->

                <section
                  id="web-design"
                  class="mb-32"
                >

                  <div class="mb-8">

                    <p class="project-number">
                      02
                    </p>

                    <h2 class="project-heading">
                      Web Design
                    </h2>

                  </div>


                  <div class="space-y-4">

                    <figure>

                      <img
                        src="/images/nordic-hair-glow/web-main.jpg"
                        alt="Nordic Hair Glow website design"
                        loading="lazy"
                        class="w-full h-auto object-cover"
                      />

                    </figure>


                    <div class="grid grid-cols-2 gap-4">

                      <figure>

                        <img
                          src="/images/nordic-hair-glow/web-mobile-01.jpg"
                          alt="Nordic Hair Glow mobile website"
                          loading="lazy"
                          class="w-full h-auto object-cover"
                        />

                      </figure>


                      <figure class="mt-12">

                        <img
                          src="/images/nordic-hair-glow/web-mobile-02.jpg"
                          alt="Nordic Hair Glow mobile website"
                          loading="lazy"
                          class="w-full h-auto object-cover"
                        />

                      </figure>

                    </div>


                    <figure>

                      <img
                        src="/images/nordic-hair-glow/web-detail.jpg"
                        alt="Nordic Hair Glow website detail"
                        loading="lazy"
                        class="w-full h-auto object-cover"
                      />

                    </figure>

                  </div>

                </section>


                <!-- 03 PHOTOGRAPHY -->

                <section
                  id="photography"
                  class="mb-32"
                >

                  <div class="mb-8">

                    <p class="project-number">
                      03
                    </p>

                    <h2 class="project-heading">
                      Photography
                    </h2>

                  </div>


                  <div class="grid grid-cols-2 gap-4">

                    <figure class="col-span-2">

                      <img
                        src="/images/nordic-hair-glow/photo-01.jpg"
                        alt="Nordic Hair Glow product photography"
                        loading="lazy"
                        class="w-full h-auto object-cover"
                      />

                    </figure>


                    <figure>

                      <img
                        src="/images/nordic-hair-glow/photo-02.jpg"
                        alt="Nordic Hair Glow product photography"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="mt-12">

                      <img
                        src="/images/nordic-hair-glow/photo-03.jpg"
                        alt="Nordic Hair Glow product photography"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="col-span-2">

                      <img
                        src="/images/nordic-hair-glow/photo-04.jpg"
                        alt="Nordic Hair Glow photography"
                        loading="lazy"
                        class="w-full h-auto object-cover"
                      />

                    </figure>

                  </div>

                </section>


                <!-- 04 AI -->

                <section
                  id="ai-imagery"
                  class="mb-32"
                >

                  <div class="mb-8">

                    <p class="project-number">
                      04
                    </p>

                    <h2 class="project-heading">
                      AI Imagery
                    </h2>

                  </div>


                  <div class="grid grid-cols-2 gap-4">

                    <figure>

                      <img
                        src="/images/nordic-hair-glow/ai-01.jpg"
                        alt="AI generated Nordic Hair Glow imagery"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="mt-12">

                      <img
                        src="/images/nordic-hair-glow/ai-02.jpg"
                        alt="AI generated Nordic Hair Glow imagery"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="col-span-2">

                      <img
                        src="/images/nordic-hair-glow/ai-03.jpg"
                        alt="AI generated Nordic Hair Glow imagery"
                        loading="lazy"
                        class="w-full h-auto object-cover"
                      />

                    </figure>


                    <figure>

                      <img
                        src="/images/nordic-hair-glow/ai-04.jpg"
                        alt="AI generated Nordic Hair Glow imagery"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="mt-12">

                      <img
                        src="/images/nordic-hair-glow/ai-05.jpg"
                        alt="AI generated Nordic Hair Glow imagery"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>

                  </div>

                </section>


                <!-- 05 PACKAGING -->

                <section
                  id="packaging"
                  class="mb-20"
                >

                  <div class="mb-8">

                    <p class="project-number">
                      05
                    </p>

                    <h2 class="project-heading">
                      Packaging
                    </h2>

                  </div>


                  <div class="grid grid-cols-2 gap-4">

                    <figure class="col-span-2">

                      <img
                        src="/images/nordic-hair-glow/packaging-01.jpg"
                        alt="Nordic Hair Glow packaging design"
                        loading="lazy"
                        class="w-full h-auto object-cover"
                      />

                    </figure>


                    <figure>

                      <img
                        src="/images/nordic-hair-glow/packaging-02.jpg"
                        alt="Nordic Hair Glow packaging detail"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>


                    <figure class="mt-12">

                      <img
                        src="/images/nordic-hair-glow/packaging-03.jpg"
                        alt="Nordic Hair Glow packaging detail"
                        loading="lazy"
                        class="w-full aspect-[4/5] object-cover"
                      />

                    </figure>

                  </div>

                </section>

              </div>


              <!-- RIGHT — NORDIC INFO -->

              <aside
                class="order-1 lg:order-2 lg:sticky lg:top-24 self-start"
              >

                <div class="project-intro">

                  <div class="project-meta">

                    <span>{project.category}</span>

                    <span>·</span>

                    <span>{project.year}</span>

                    {
                      project.tags?.map((tag) => (
                        <>
                          <span>·</span>
                          <span>{tag}</span>
                        </>
                      ))
                    }

                  </div>


                  <h1
                    class="heading-display text-5xl md:text-6xl lg:text-7xl leading-tight text-primary mb-8 mt-8"
                  >
                    {project.title}
                  </h1>


                  <p class="project-description">
                    {project.description}
                  </p>


                  {
                    project.longDescription && (
                      <p class="project-extra-text nordic-long-description">
                        {project.longDescription}
                      </p>
                    )
                  }


                  {
                    project.link && (
                      <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-external inline-flex items-center gap-1 font-sans text-base font-medium"
                      >
                        {project.linkLabel ??
                          (project.link.includes("figma")
                            ? "View prototype"
                            : "Visit website")}

                        <span aria-hidden="true">
                          ↗
                        </span>
                      </a>
                    )
                  }


                  <nav
                    aria-label="Project sections"
                    class="project-navigation"
                  >

                    <p class="project-navigation-label">
                      Project
                    </p>


                    <div class="space-y-3">

                      <a
                        href="#meta-ads"
                        data-section-link="meta-ads"
                        class="project-nav-link active"
                      >
                        <span>01</span>
                        Meta Ads
                      </a>


                      <a
                        href="#web-design"
                        data-section-link="web-design"
                        class="project-nav-link"
                      >
                        <span>02</span>
                        Web Design
                      </a>


                      <a
                        href="#photography"
                        data-section-link="photography"
                        class="project-nav-link"
                      >
                        <span>03</span>
                        Photography
                      </a>


                      <a
                        href="#ai-imagery"
                        data-section-link="ai-imagery"
                        class="project-nav-link"
                      >
                        <span>04</span>
                        AI Imagery
                      </a>


                      <a
                        href="#packaging"
                        data-section-link="packaging"
                        class="project-nav-link"
                      >
                        <span>05</span>
                        Packaging
                      </a>

                    </div>

                  </nav>

                </div>

              </aside>

            </section>

          ) : (

            <!-- ================================================= -->
            <!-- OTHER PROJECTS -->
            <!-- ================================================= -->

            <section class="other-project-layout">

              <!-- LEFT -->

              <div class="other-project-text">

                <div class="mb-8">

                  <a
                    href="/#projects"
                    class="inline-flex items-center gap-2 font-sans text-sm text-muted-foreground hover:text-primary transition-colors"
                  >
                    <span aria-hidden="true">←</span>
                    Back to projects
                  </a>

                </div>


                <!-- META -->

                <div class="project-meta">

                  <span>{project.category}</span>

                  <span>·</span>

                  <span>{project.year}</span>

                  {
                    project.tags?.map((tag) => (
                      <>
                        <span>·</span>
                        <span>{tag}</span>
                      </>
                    ))
                  }

                </div>


                <!-- TITLE -->

                <h1
                  class="heading-display text-5xl md:text-6xl lg:text-7xl mb-8 leading-tight text-primary"
                >
                  {project.title}
                </h1>


                <!-- DESCRIPTION -->

                <p class="project-description">
                  {project.description}
                </p>


                <!-- LINK -->

                {
                  project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-external inline-flex items-center gap-1 font-sans text-base font-medium"
                    >
                      {project.linkLabel ??
                        (project.link.includes("figma")
                          ? "View prototype"
                          : "Visit website")}

                      <span aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  )
                }


                <!-- MORE INFORMATION -->

                {
                  project.longDescription && (
                    <div class="project-extra-info">

                      <p class="project-extra-label">
                        About the project
                      </p>

                      <p class="project-extra-text">
                        {project.longDescription}
                      </p>

                    </div>
                  )
                }

              </div>


              <!-- RIGHT — FIXED VIEWPORT IMAGE AREA -->

              <div class="other-project-images -mt-5">

                <div class="image-scroll-area">

                  {
                    project.video && (
                      <figure class="project-media">

                        <video
                          controls
                          preload="metadata"
                          class="block w-full aspect-video object-cover"
                        >

                          <source
                            src={project.video}
                            type="video/mp4"
                          />

                        </video>

                      </figure>
                    )
                  }


                  {
                    project.gallery?.map((image, index) => (

                      <figure class="project-media">

                        <img
                          src={image}
                          alt={`${project.title} image ${index + 1}`}
                          loading={index === 0 ? "eager" : "lazy"}
                          class="block w-full h-auto"
                        />

                      </figure>

                    ))
                  }

                </div>

              </div>

            </section>

          )
        }

      </div>


      <Footer />

    </main>

  </div>


  <!-- =============================================================== -->
  <!-- NORDIC ACTIVE SECTION -->
  <!-- =============================================================== -->

  {
    isNordicHairGlow && (
      <script>
        const sections = Array.from(
          document.querySelectorAll<HTMLElement>(
            "#meta-ads, #web-design, #photography, #ai-imagery, #packaging"
          )
        );

        const links = Array.from(
          document.querySelectorAll<HTMLAnchorElement>(
            "[data-section-link]"
          )
        );

        const updateActiveSection = () => {

          const position =
            window.scrollY +
            window.innerHeight * 0.35;

          let activeId = sections[0]?.id;

          sections.forEach((section) => {

            if (position >= section.offsetTop) {
              activeId = section.id;
            }

          });

          links.forEach((link) => {

            const active =
              link.dataset.sectionLink === activeId;

            link.classList.toggle(
              "active",
              active
            );

          });

        };

        window.addEventListener(
          "scroll",
          updateActiveSection,
          { passive: true }
        );

        updateActiveSection();
      </script>
    )
  }


  <!-- =============================================================== -->
  <!-- STYLES -->
  <!-- =============================================================== -->

  <style>

    html {
      scroll-behavior: smooth;
    }


    /* ==========================================================
       GENERAL PROJECT TYPOGRAPHY
       ========================================================== */

    .project-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;

      font-family: sans-serif;
      font-size: 0.875rem;

      color: hsl(var(--muted-foreground));
    }


    .project-description {
      max-width: 38rem;

      margin-bottom: 1.75rem;

      font-family: sans-serif;

      font-size: clamp(
        1.25rem,
        2vw,
        1.75rem
      );

      line-height: 1.35;

      color: hsl(var(--foreground));
    }


    /* ==========================================================
       NORDIC
       ========================================================== */

    .project-number {
      margin: 0;

      font-family: sans-serif;

      font-size: 0.75rem;

      letter-spacing: 0.18em;

      text-transform: uppercase;

      color: hsl(var(--muted-foreground));
    }


    .project-heading {
      margin-top: 0.5rem;

      font-family: var(--font-heading, sans-serif);

      font-size: clamp(
        2.25rem,
        4vw,
        3rem
      );

      line-height: 1;

      color: hsl(var(--primary));
    }


    .project-navigation {
      margin-top: 2.5rem;

      padding-top: 1.25rem;

      border-top:
        1px solid
        hsl(var(--border));
    }


    .project-navigation-label {
      margin-bottom: 1rem;

      font-family: sans-serif;

      font-size: 0.75rem;

      letter-spacing: 0.18em;

      text-transform: uppercase;

      color: hsl(var(--muted-foreground));
    }


    .project-nav-link {
      display: block;

      position: relative;

      font-family: sans-serif;

      font-size: 0.875rem;

      color: hsl(var(--muted-foreground));

      transition:
        color 200ms ease,
        padding-left 200ms ease;
    }


    .project-nav-link span {
      display: inline-block;

      width: 2rem;

      color:
        hsl(var(--muted-foreground) / 0.5);
    }


    .project-nav-link.active {
      color: hsl(var(--primary));

      padding-left: 0.375rem;
    }


    .project-nav-link.active::before {
      content: "";

      position: absolute;

      left: -0.625rem;

      top: 50%;

      width: 3px;

      height: 14px;

      transform:
        translateY(-50%);

      background:
        currentColor;
    }


    /* ==========================================================
       NORDIC LONG DESCRIPTION
       ========================================================== */

    .nordic-long-description {
      max-width: 38rem;

      margin-top: 0;

      margin-bottom: 2rem;

      font-family: sans-serif;

      font-size: 1rem;

      line-height: 1.7;

      color: hsl(var(--muted-foreground));

      white-space: pre-line;
    }


    /* ==========================================================
       OTHER PROJECTS
       ========================================================== */

    .other-project-layout {
      display: grid;

      grid-template-columns:
        minmax(0, 0.9fr)
        minmax(0, 1.1fr);

      gap: 4rem;

      align-items: start;
    }


    /* ==========================================================
       LEFT TEXT
       ========================================================== */

    .other-project-text {
      min-width: 0;

      padding-top: 0.5rem;
    }


    .project-extra-info {
      margin-top: 4rem;

      padding-top: 1.5rem;

      border-top:
        1px solid
        hsl(var(--border));
    }


    .project-extra-label {
      margin-bottom: 1rem;

      font-family: sans-serif;

      font-size: 0.75rem;

      letter-spacing: 0.18em;

      text-transform: uppercase;

      color: hsl(var(--muted-foreground));
    }


    .project-extra-text {
      max-width: 38rem;

      font-family: sans-serif;

      font-size: 1rem;

      line-height: 1.7;

      color: hsl(var(--muted-foreground));

      white-space: pre-line;
    }


    /* ==========================================================
       RIGHT IMAGE AREA
       ========================================================== */

    .other-project-images {
      position: sticky;

      top: 6rem;

      height: 80vh;

      min-height: 500px;

      min-width: 0;

      align-self: start;
    }


    .image-scroll-area {
      width: 100%;

      height: 100%;

      overflow-y: auto;

      overflow-x: hidden;

      overscroll-behavior: contain;

      scrollbar-width: thin;

      scrollbar-color:
        rgba(0, 0, 0, 0.18)
        transparent;
    }


    .image-scroll-area::-webkit-scrollbar {
      width: 4px;
    }


    .image-scroll-area::-webkit-scrollbar-track {
      background: transparent;
    }


    .image-scroll-area::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.18);

      border-radius: 999px;
    }


    .project-media {
      width: 100%;

      margin: 0 0 1rem 0;
    }


    .project-media:last-child {
      margin-bottom: 0;
    }


    .project-media img {
      display: block;

      width: 100%;

      height: auto;
    }


    /* ==========================================================
       MOBILE
       ========================================================== */

    @media (max-width: 1023px) {

      .other-project-layout {
        display: block;
      }


      .other-project-text {
        padding-top: 0;
      }


      .other-project-images {
        position: static;

        height: auto;

        min-height: 0;

        margin-top: 4rem;
      }


      .image-scroll-area {
        height: auto;

        overflow: visible;

        overscroll-behavior: auto;
      }


      .project-extra-info {
        margin-top: 3rem;
      }


      .project-nav-link.active {
        padding-left: 0;
      }


      .project-nav-link.active::before {
        display: none;
      }

    }

  </style>

</Layout>