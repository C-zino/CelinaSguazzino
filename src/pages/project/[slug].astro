---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { getProjectBySlug, projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = slug ? getProjectBySlug(slug) : undefined;

if (!project) {
  return Astro.redirect("/");
}

const isNordicHairGlow = project.slug === "nordic-hair-glow";
---

<Layout title={`${project.title} | Celina Sguazzino`}>
  <div class="min-h-screen bg-background">

    <Navigation />

    <main
      class:list={[
        "min-h-screen px-4 pb-24 md:px-5 lg:px-8",
        isNordicHairGlow ? "pt-0" : "pt-24 md:pt-28",
      ]}
    >

      <div class="mx-auto max-w-7xl lg:pl-10">

        {
          isNordicHairGlow ? (

            <!-- ================================================= -->
            <!-- NORDIC HAIR GLOW -->
            <!-- ================================================= -->

            <section
              class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(320px,3fr)] lg:gap-12 xl:gap-16 2xl:gap-20"
            >

              <!-- ================================================= -->
              <!-- NORDIC PROJECT MENU -->
              <!-- Only visible on 2xl and larger screens -->
              <!-- ================================================= -->

              <nav
                aria-label="Project sections"
                class="fixed left-15 top-24 z-40 hidden 2xl:block"
              >

                <p
                  class="mb-3 font-sans text-[0.7rem] uppercase tracking-[0.18em] text-muted-foreground"
                >
                  Project
                </p>

                <div class="space-y-2">

                  <a
                    href="#meta-ads"
                    data-section-link="meta-ads"
                    class="project-nav-link active block text-sm font-sans text-muted-foreground transition-colors hover:text-primary"
                  >
                    <span class="inline-block w-8 text-muted-foreground/50">
                      01
                    </span>
                    Meta Ads
                  </a>

                  <a
                    href="#web-design"
                    data-section-link="web-design"
                    class="project-nav-link block text-sm font-sans text-muted-foreground transition-colors hover:text-primary"
                  >
                    <span class="inline-block w-8 text-muted-foreground/50">
                      02
                    </span>
                    Web Design
                  </a>

                  <a
                    href="#ai-imagery"
                    data-section-link="ai-imagery"
                    class="project-nav-link block text-sm font-sans text-muted-foreground transition-colors hover:text-primary"
                  >
                    <span class="inline-block w-8 text-muted-foreground/50">
                      03
                    </span>
                    AI Imagery
                  </a>

                  <a
                    href="#packaging"
                    data-section-link="packaging"
                    class="project-nav-link block text-sm font-sans text-muted-foreground transition-colors hover:text-primary"
                  >
                    <span class="inline-block w-8 text-muted-foreground/50">
                      04
                    </span>
                    Packaging
                  </a>

                </div>

              </nav>


              <!-- ================================================= -->
              <!-- LEFT — NORDIC CONTENT / MEDIA -->
              <!-- ================================================= -->

             <div
  class="order-2 min-w-0  max-w-[500px] lg:order-1 lg:mx-0 lg:max-w-[700px] lg:pl-0 xl:pl-2 2xl:pl-4"
>
                <!-- BACK -->

                <div class="mb-10 mt-24">

                  <a
                    href="/#projects"
                    class="inline-flex items-center gap-2 font-sans text-sm text-muted-foreground transition-colors hover:text-primary"
                  >
                    <span aria-hidden="true">←</span>
                    Back to projects
                  </a>

                </div>


                <!-- ================================================= -->
                <!-- 01 META ADS -->
                <!-- ================================================= -->

                <section
                  id="meta-ads"
                  class="mb-32 scroll-mt-28"
                >

                  <div class="mb-8">

                    <p class="project-number">
                      01
                    </p>

                    <h2
                      class="mt-2 font-heading text-3xl font-normal leading-tight tracking-[-0.02em] text-primary md:text-4xl"
                    >
                      Meta Ads
                    </h2>

                  </div>


                  <div class="grid grid-cols-2 gap-3 md:gap-4">

                    <!-- VIDEO 01 -->

                    <figure class="w-full overflow-hidden">
                      <video
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="auto"
                        class="block h-auto w-full"
                      >
                        <source
                          src="/videos/nordichairglow/Video1.mp4"
                          type="video/mp4"
                        />
                      </video>
                    </figure>


                    <!-- VIDEO 02 — SLIGHTLY LOWER -->

                    <figure class="mt-8 w-full overflow-hidden md:mt-12">
                      <video
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="auto"
                        class="block h-auto w-full"
                      >
                        <source
                          src="/videos/nordichairglow/Video2.mp4"
                          type="video/mp4"
                        />
                      </video>
                    </figure>


                    <!-- META IMAGE 01 -->

                    <figure class="w-full">
                      <img
                        src="/images/projects/nordichairglow/meta1.png"
                        alt="Nordic Hair Glow Meta advertising creative"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />
                    </figure>


                    <!-- META IMAGE 02 — SLIGHTLY LOWER -->

                    <figure class="mt-8 w-full md:mt-12">
                      <img
                        src="/images/projects/nordichairglow/meta2.png"
                        alt="Nordic Hair Glow Meta advertising creative"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />
                    </figure>


                    <!-- META IMAGE 03 -->

                    <figure class="w-full">
                      <img
                        src="/images/projects/nordichairglow/meta3.png"
                        alt="Nordic Hair Glow Meta advertising creative"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />
                    </figure>


                    <!-- META IMAGE 04 — SLIGHTLY LOWER -->

                    <figure class="mt-8 w-full md:mt-12">
                      <img
                        src="/images/projects/nordichairglow/meta4.png"
                        alt="Nordic Hair Glow Meta advertising creative"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />
                    </figure>

                  </div>

                </section>


                <!-- ================================================= -->
                <!-- 02 WEB DESIGN -->
                <!-- ================================================= -->

                <section
                  id="web-design"
                  class="mb-32 scroll-mt-28"
                >

                  <div class="mb-8">

                    <p
                      class="m-0 font-sans text-xs uppercase tracking-[0.18em] text-muted-foreground"
                    >
                      02
                    </p>

                    <h2
                      class="mt-2 font-heading text-3xl font-normal leading-tight tracking-[-0.02em] text-primary md:text-4xl"
                    >
                      Web Design
                    </h2>

                  </div>


                  <div class="space-y-6">

                    <!-- MAIN WEB DESIGN -->

                    <figure>

                      <img
                        src="/images/projects/nordichairglow/webdesign1.png"
                        alt="Nordic Hair Glow web design"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- SECOND WEB DESIGN -->

                    <figure>

                      <img
                        src="/images/projects/nordichairglow/webdesign2.png"
                        alt="Nordic Hair Glow web design"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- MOBILE DESIGNS -->

                    <div class="grid grid-cols-2 gap-3 md:gap-4">

                      <figure>

                        <img
                          src="/images/projects/nordichairglow/webdesignmobile1.PNG"
                          alt="Nordic Hair Glow mobile web design"
                          loading="lazy"
                          class="block h-auto w-full object-contain"
                        />

                      </figure>


                      <figure class="mt-8 md:mt-12">

                        <img
                          src="/images/projects/nordichairglow/webdesignmobile2.PNG"
                          alt="Nordic Hair Glow mobile web design"
                          loading="lazy"
                          class="block h-auto w-full object-contain"
                        />

                      </figure>

                    </div>

                  </div>

                </section>


                <!-- ================================================= -->
                <!-- 03 AI IMAGERY -->
                <!-- ================================================= -->

                <section
                  id="ai-imagery"
                  class="mb-32 scroll-mt-28"
                >

                  <div class="mb-8">

                    <p
                      class="m-0 font-sans text-xs uppercase tracking-[0.18em] text-muted-foreground"
                    >
                      03
                    </p>

                    <h2
                      class="mt-2 font-heading text-3xl font-normal leading-tight tracking-[-0.02em] text-primary md:text-4xl"
                    >
                      AI Imagery
                    </h2>

                  </div>


                  <div class="grid grid-cols-2 gap-3 md:gap-4">

                    <!-- AI 1 -->

                    <figure>

                      <img
                        src="/images/projects/nordichairglow/ai1.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 2 -->

                    <figure class="mt-8 md:mt-12">

                      <img
                        src="/images/projects/nordichairglow/ai3.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 3 -->

                    <figure class="col-span-2">

                      <img
                        src="/images/projects/nordichairglow/ai2.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 4 -->

                    <figure class="mt-4 md:mt-5">

                      <img
                        src="/images/projects/nordichairglow/ai6.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 5 -->

                    <figure class="mt-8 md:mt-12">

                      <img
                        src="/images/projects/nordichairglow/ai5.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 6 -->

                    <figure class="col-span-2">

                      <img
                        src="/images/projects/nordichairglow/ai7.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 7 -->

                    <figure>

                      <img
                        src="/images/projects/nordichairglow/ai8.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 8 -->

                    <figure class="mt-8 md:mt-12">

                      <img
                        src="/images/projects/nordichairglow/ai9.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 9 -->

                    <figure class="col-span-2">

                      <img
                        src="/images/projects/nordichairglow/ai10.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>


                    <!-- AI 10 -->

                    <figure class="col-span-2">

                      <img
                        src="/images/projects/nordichairglow/ai11.png"
                        alt="Nordic Hair Glow AI imagery"
                        loading="lazy"
                        class="block h-auto w-full object-contain"
                      />

                    </figure>

                  </div>

                </section>


                <!-- ================================================= -->
                <!-- 04 PACKAGING -->
                <!-- ================================================= -->

                <section
                  id="packaging"
                  class="mb-20 scroll-mt-28"
                >

                  <div class="mb-8">

                    <p
                      class="m-0 font-sans text-xs uppercase tracking-[0.18em] text-muted-foreground"
                    >
                      04
                    </p>

                    <h2
                      class="mt-2 font-heading text-3xl font-normal leading-tight tracking-[-0.02em] text-primary md:text-4xl"
                    >
                      Packaging (conceptual)
                    </h2>

                  </div>


                 <div class="grid grid-cols-2 gap-3 md:gap-4">

  <!-- PACKAGING 01 -->

  <figure class="w-full">
    <img
      src="/images/projects/nordichairglow/pack1.png"
      alt="Nordic Hair Glow packaging design"
      loading="lazy"
      class="block h-auto w-full object-contain"
    />
  </figure>


  <!-- PACKAGING 02 — SLIGHTLY LOWER -->

  <figure class="mt-8 w-full md:mt-12">
    <img
      src="/images/projects/nordichairglow/pack2.png"
      alt="Nordic Hair Glow packaging design"
      loading="lazy"
      class="block h-auto w-full object-contain"
    />
  </figure>


  <!-- PACKAGING 03 -->

  <figure class="w-full md:mt-5">
    <img
      src="/images/projects/nordichairglow/pack3.png"
      alt="Nordic Hair Glow packaging design"
      loading="lazy"
      class="block h-auto w-full object-contain"
    />
  </figure>


  <!-- PACKAGING 04 — SLIGHTLY LOWER -->

  <figure class="mt-8 w-full md:mt-15">
    <img
      src="/images/projects/nordichairglow/pack4.png"
      alt="Nordic Hair Glow packaging design"
      loading="lazy"
      class="block h-auto w-full object-contain"
    />
  </figure>

</div>

                </section>

              </div>


              <!-- ================================================= -->
              <!-- RIGHT — NORDIC INTRO -->
              <!-- ================================================= -->

              <aside
                class="order-1 min-w-0 self-start md:mt-30 lg:mt-0 lg:order-2 lg:sticky lg:top-24"
              >

                <div>

                  <div class="project-meta">

                    <span>{project.category}</span>

                    <span>·</span>

                    <span>{project.year}</span>

                    {
                      project.tags?.map((tag) => (
                        <>
                          <span>·</span>
                          <span>{tag}</span>
                        </>
                      ))
                    }

                  </div>


                  <h1
                    class="heading-display mt-8 mb-8 text-4xl leading-tight text-primary md:text-5xl lg:text-5xl xl:text-6xl"
                  >
                    {project.title}
                  </h1>


                  <p class="project-description">
                    {project.description}
                  </p>


                  {
                    project.longDescription && (
                      <p
                        class="mb-8 max-w-[38rem] whitespace-pre-line font-sans text-base leading-[1.7] text-muted-foreground"
                      >
                        {project.longDescription}
                      </p>
                    )
                  }


                  {
                    project.link && (
                      <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-external inline-flex items-center gap-1 font-sans text-base font-medium"
                      >
                        {project.linkLabel ??
                          (project.link.includes("figma")
                            ? "View prototype"
                            : "Visit website")}

                        <span aria-hidden="true">
                          ↗
                        </span>
                      </a>
                    )
                  }

                </div>

              </aside>

            </section>

          ) : (

            <!-- ================================================= -->
            <!-- OTHER PROJECTS -->
            <!-- ================================================= -->

            <section
              class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-20 -mt-5"
            >

              <!-- LEFT — PROJECT TEXT -->

              <div class="min-w-0 pt-0 lg:pt-2 mt-5">

                <div class="mb-8">

                  <a
                    href="/#projects"
                    class="inline-flex items-center gap-2 font-sans text-sm text-muted-foreground transition-colors hover:text-primary"
                  >
                    <span aria-hidden="true">←</span>
                    Back to projects
                  </a>

                </div>


                <div class="project-meta">

                  <span>{project.category}</span>

                  <span>·</span>

                  <span>{project.year}</span>

                  {
                    project.tags?.map((tag) => (
                      <>
                        <span>·</span>
                        <span>{tag}</span>
                      </>
                    ))
                  }

                </div>


                <h1
                  class="heading-display mb-8 mt-8 text-4xl leading-tight text-primary md:text-5xl lg:text-6xl"
                >
                  {project.title}
                </h1>


                <p class="project-description">
                  {project.description}
                </p>


                {
                  project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-external inline-flex items-center gap-1 font-sans text-base font-medium"
                    >
                      {project.linkLabel ??
                        (project.link.includes("figma")
                          ? "View prototype"
                          : "Visit website")}

                      <span aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  )
                }


                {
                  project.longDescription && (
                    <div
                      class="mt-12 border-t border-border pt-6 lg:mt-16"
                    >

                      <p
                        class="mb-4 font-sans text-xs uppercase tracking-[0.18em] text-muted-foreground"
                      >
                        About the project
                      </p>

                      <p
                        class="max-w-[38rem] whitespace-pre-line font-sans text-base leading-[1.7] text-muted-foreground"
                      >
                        {project.longDescription}
                      </p>

                    </div>
                  )
                }

              </div>


              <!-- RIGHT — PROJECT MEDIA -->

              <div
                class="sticky top-24 h-[80vh] min-h-[500px] min-w-0 self-start max-lg:static max-lg:mt-8 max-lg:h-auto max-lg:min-h-0"
              >

              <div
  class="h-full overflow-y-scroll overflow-x-hidden overscroll-contain scrollbar-thin max-lg:h-auto max-lg:overflow-visible max-w-[600px] lg:max-w-[800px]"
>

                  {
                    project.video && (
                      <figure class="mb-4 w-full">
                        <video
                          controls
                          preload="metadata"
                          class="block h-auto w-full object-contain"
                        >
                          <source
                            src={project.video}
                            type="video/mp4"
                          />
                        </video>
                      </figure>
                    )
                  }


                  {
                    project.gallery?.map((image, index) => (

                      <figure class="mb-4 w-full last:mb-0">

                        <img
                          src={image}
                          alt={`${project.title} image ${index + 1}`}
                          loading={index === 0 ? "eager" : "lazy"}
                          class="block h-auto w-full object-contain"
                        />

                      </figure>

                    ))
                  }

                </div>

              </div>

            </section>

          )
        }

      </div>


      <Footer />

    </main>

  </div>


  <!-- =============================================================== -->
  <!-- NORDIC ACTIVE SECTION SCRIPT -->
  <!-- =============================================================== -->

  {
    isNordicHairGlow && (
      <script>
        const sections = Array.from(
          document.querySelectorAll<HTMLElement>(
            "#meta-ads, #web-design, #ai-imagery, #packaging"
          )
        );

        const links = Array.from(
          document.querySelectorAll<HTMLAnchorElement>(
            "[data-section-link]"
          )
        );

        const updateActiveSection = () => {

          const position =
            window.scrollY +
            window.innerHeight * 0.35;

          let activeId = sections[0]?.id;

          sections.forEach((section) => {

            if (position >= section.offsetTop) {
              activeId = section.id;
            }

          });

          links.forEach((link) => {

            const active =
              link.dataset.sectionLink === activeId;

            link.classList.toggle(
              "active",
              active
            );

            link.classList.toggle(
              "text-primary",
              active
            );

            link.classList.toggle(
              "text-muted-foreground",
              !active
            );

          });

        };


        window.addEventListener(
          "scroll",
          updateActiveSection,
          { passive: true }
        );

        updateActiveSection();
      </script>
    )
  }


  <!-- =============================================================== -->
  <!-- SMALL AMOUNT OF CSS -->
  <!-- =============================================================== -->

  <style>
    html {
      scroll-behavior: smooth;
    }

    .project-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      font-family: sans-serif;
      font-size: 0.875rem;
      color: hsl(var(--muted-foreground));
    }

    .project-description {
      max-width: 38rem;
      margin-bottom: 1.75rem;
      font-family: sans-serif;
      font-size: clamp(1.2rem, 2vw, 1.6rem);
      line-height: 1.35;
      color: hsl(var(--foreground));
    }

    .project-nav-link {
      position: relative;
    }

    .project-nav-link.active {
      padding-left: 0.375rem;
    }

    .project-nav-link.active::before {
      content: "";
      position: absolute;
      left: -0.625rem;
      top: 50%;
      width: 3px;
      height: 14px;
      transform: translateY(-50%);
      background: currentColor;
    }

    @media (max-width: 1023px) {
      .project-nav-link.active {
        padding-left: 0;
      }

      .project-nav-link.active::before {
        display: none;
      }
    }
  </style>

</Layout>