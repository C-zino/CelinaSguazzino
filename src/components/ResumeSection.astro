---

<section
  id="resume"
  class:list={[
    "section-container",
    "lg:!max-w-[1200px]",
    "lg:!mx-auto",
    "!pt-20",
    "relative",
  ]}
>
  <h3 class="section-header">CV</h3>

  <div class="relative">

    <!-- Clickable tabs on all screen sizes -->
    <div>

      <!-- TAB NAVIGATION -->
      <div
        data-tablist
        role="tablist"
        aria-label="CV categories"
        class="mb-12 overflow-x-auto whitespace-nowrap border-b border-black/10 bg-background/90 pb-4 pt-2 backdrop-blur-sm"
      >
        <div class="relative flex items-center gap-3 md:gap-6">

          {
            tabs.map((tab) => (
              <button
                type="button"
                role="tab"
                aria-selected={tab.key === defaultTab}
                data-tab-trigger={tab.key}
                class:list={[
                  "relative shrink-0 font-display text-3xl md:text-5xl tracking-wide uppercase transition-colors",
                  tab.key === defaultTab
                    ? "text-foreground"
                    : "text-muted-foreground hover:text-foreground",
                ]}
              >
                {tab.label}
              </button>
            ))
          }

          <!-- Active tab line -->
          <span
            data-tab-line
            class="pointer-events-none absolute bottom-0 left-0 h-[2px] bg-primary transition-all duration-300 ease-out"
          ></span>

        </div>
      </div>

      <!-- CONTENT -->
      <div class="relative">

        {
          tabs.map((tab) => (
            <div
              data-tab-panel={tab.key}
              class:list={[
                "tab-panel w-full",
                tab.key === defaultTab ? "block" : "hidden",
              ]}
            >

              <div
                class:list={[
                  "grid gap-x-10 gap-y-12",
                  "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
                ]}
              >

                {
                  tab.entries.map((entry) => (
                    <div class="border-t border-black/10 pt-5 font-sans">

                      <!-- Entry title -->
                      <h4
                        class="font-sans text-xl md:text-2xl font-medium text-foreground leading-tight"
                      >
                        {entry.title}

                        {entry.meta && (
                          <span
                            class="block mt-1 font-sans text-sm font-normal text-muted-foreground"
                          >
                            {entry.meta}
                          </span>
                        )}
                      </h4>

                      <!-- Subtitle -->
                      {entry.subtitle && (
                        <p
                          class="mt-1 font-sans text-base text-foreground/80"
                        >
                          {entry.subtitle}
                        </p>
                      )}

                      <!-- Description -->
                      <ul class="mt-4 space-y-2 font-sans">
                        {
                          entry.points.map((point) => (
                            <li
                              class="relative pl-4 font-sans text-sm md:text-base font-normal leading-relaxed text-muted-foreground"
                            >
                              <span
                                class="absolute left-0 top-[0.6em] h-1.5 w-1.5 bg-primary"
                              ></span>

                              {point}
                            </li>
                          ))
                        }
                      </ul>

                    </div>
                  ))
                }

              </div>
            </div>
          ))
        }

      </div>
    </div>

  </div>
</section>

<script>
  const initialTab = "uddannelse";

  /*
   * Typed DOM elements
   */

  const tabButtons =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-tab-trigger]"
    );

  const tabPanels =
    document.querySelectorAll<HTMLElement>(
      "[data-tab-panel]"
    );

  const tabLine =
    document.querySelector<HTMLElement>(
      "[data-tab-line]"
    );

  /*
   * Update active underline
   */
  const updateTabLine = (
    button: HTMLButtonElement | null
  ): void => {

    if (!tabLine || !button) return;

    tabLine.style.width =
      `${button.offsetWidth}px`;

    tabLine.style.transform =
      `translateX(${button.offsetLeft}px)`;
  };

  /*
   * Change active tab
   */
  const setActiveTab = (
    key: string
  ): void => {

    /*
     * Update buttons
     */
    tabButtons.forEach((button) => {

      const isActive =
        button.dataset.tabTrigger === key;

      button.setAttribute(
        "aria-selected",
        String(isActive)
      );

      button.classList.toggle(
        "text-foreground",
        isActive
      );

      button.classList.toggle(
        "text-muted-foreground",
        !isActive
      );

      button.classList.toggle(
        "hover:text-foreground",
        !isActive
      );

    });

    /*
     * Update underline
     */
    const activeButton =
      document.querySelector<HTMLButtonElement>(
        `[data-tab-trigger="${key}"]`
      );

    updateTabLine(activeButton);

    /*
     * Update panels
     */
    tabPanels.forEach((panel) => {

      const isActive =
        panel.dataset.tabPanel === key;
      panel.classList.toggle(
        "hidden",
        !isActive
      );

    });
  };

  /*
   * Tab clicks
   */
  tabButtons.forEach((button) => {

    button.addEventListener(
      "click",
      () => {

        const key =
          button.dataset.tabTrigger;

        if (!key) return;

        setActiveTab(key);

      }
    );

  });

  window.addEventListener(
    "resize",
    () => {

      const activeButton =
        document.querySelector<HTMLButtonElement>(
          '[aria-selected="true"]'
        );

      updateTabLine(activeButton);

      setActiveTab(
        activeButton?.dataset.tabTrigger ||
          initialTab
      );

    }
  );

  /*
   * Initial state
   */
  setActiveTab(initialTab);

  const updateInitialTabLine = (): void => {
    const activeButton =
      document.querySelector<HTMLButtonElement>(
        '[aria-selected="true"]'
      );

    updateTabLine(activeButton);
  };

  requestAnimationFrame(updateInitialTabLine);
  document.fonts?.ready.then(updateInitialTabLine);
</script>