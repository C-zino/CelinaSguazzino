---
const education = [];
---

<section class="section-container">
  <h3 class="section-header">education</h3>
  <div class="flex flex-col gap-10">
    {
      education.map((item) => (
        <div class="border-b border-border pb-6">
          <div class="flex items-baseline justify-between gap-4 mb-2 flex-wrap">
            <span class="font-serif text-xl md:text-2xl text-foreground">
              {item.degree}
            </span>
            <span class="text-sm text-muted-foreground">{item.period}</span>
          </div>
          <span class="text-sm text-muted-foreground">{item.institution}</span>
        </div>
      ))
    }
  </div>
</section>
