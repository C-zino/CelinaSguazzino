<script>
  const updateFooterTime = () => {
    const node = document.getElementById("footer-local-time");

    if (!node) return;

    const now = new Date();

    node.textContent = window.portfolioI18n.formatLocalTime(now);
  };

  updateFooterTime();
  window.addEventListener("languagechange", updateFooterTime);

  setInterval(updateFooterTime, 60000);
</script>
