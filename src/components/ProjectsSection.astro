---
import { projects } from "../data/projects";

interface Props {
  limit?: number;
  showMoreLink?: boolean;
  headingKey?: string;
  headingText?: string;
  containerClass?: string;
  wideLayout?: boolean;
  compactLayout?: boolean;
}

const {
  limit,
  showMoreLink = false,
  headingKey = "projects.heading",
  headingText = "udvalgte projekter",
  containerClass,
  wideLayout = false,
  compactLayout = false,
} = Astro.props;
const visibleProjects = limit ? projects.slice(0, limit) : projects;

type LocalizedValue = string | Partial<Record<"da" | "en", string>>;

const localize = (value: LocalizedValue, language: "da" | "en" = "da") => {
  if (typeof value === "string") return value;
  return value?.[language] ?? value?.da ?? "";
};
---

<section
  id="projects"
  class:list={["bg-secondary/30", compactLayout ? "projects-compact" : ""]}
>
  <div class:list={["section-container pb-10 md:pb-30", containerClass]}>

    <h3
      id="projects-heading"
      class:list={[
        "scroll-mt-24 pt-15 section-header reveal-section",
        compactLayout ? "!mb-8 md:!mb-12" : "",
      ]}
      data-i18n={headingKey}
    >
      {headingText}
    </h3>

    <div class:list={[
      "flex flex-col",
      compactLayout ? "gap-10 md:gap-16" : "gap-16 md:gap-24",
    ]}>

      {
        visibleProjects.map((project, index) => (
          <article
            class:list={[
              "project-card font-sans",
              compactLayout ? "project-card-compact" : "",
            ]}
            style={{
              transitionDelay: `${index * (compactLayout ? 60 : 100)}ms`,
            }}
          >
            <a
              href={`/project/${project.slug}`}
              class:list={[
                "group grid grid-cols-1 items-center gap-8 md:gap-12",
                wideLayout ? "md:grid-cols-[0.9fr_1.1fr]" : "md:grid-cols-2",
              ]}
            >

              <!-- Project image -->
              <div
                class:list={[
                  "project-image overflow-hidden bg-transparent",
                  wideLayout ? "aspect-[16/10]" : "",
                ]}
              >
                <img
                  src={project.image}
                  alt={project.title}
                  width="1024"
                  height="768"
                  loading="lazy"
                  class:list={[
                    "w-full h-auto aspect-[4/3] transition-transform duration-700 ease-out group-hover:scale-[1.03]",
                    wideLayout
                      ? "aspect-[16/10] h-full object-cover"
                      : project.slug === "tivoli-moments"
                        ? "object-cover"
                        : "object-contain",
                  ]}
                />
              </div>

              <!-- Project information -->
              <div class="project-info flex flex-col font-sans">

                <!-- Category + year -->
                <div
                  class="project-meta flex items-center gap-3 text-sm font-sans text-muted-foreground mb-4"
                >
                  <span
                    data-lang-field
                    data-da={localize(project.category, "da")}
                    data-en={localize(project.category, "en")}
                  >
                    {localize(project.category, "da")}
                  </span>

                  <span class="text-muted-foreground/40">
                    ·
                  </span>

                  <span
                    data-lang-field
                    data-da={localize(project.year, "da")}
                    data-en={localize(project.year, "en")}
                  >
                    {localize(project.year, "da")}
                  </span>
                </div>

                <!-- Tags -->
                {project.tags && project.tags.length > 0 && (
                  <div
                    class="project-tags mb-4 flex flex-wrap gap-3 font-sans"
                  >
                    {project.tags.map((tag) => (
                      <span
                        data-lang-field
                        data-da={localize(tag, "da")}
                        data-en={localize(tag, "en")}
                        class="inline-flex items-center rounded-full bg-secondary/70 px-3 py-1 text-sm font-sans font-medium text-secondary-foreground transition-colors duration-300"
                      >
                        {localize(tag, "da")}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Project title -->
                <h4
                  class="project-title font-sans text-3xl md:text-4xl lg:text-5xl font-medium text-foreground mb-4 transition-colors duration-300 group-hover:text-primary"
                >
                  {project.title}
                </h4>

                <!-- Description -->
                <p
                  data-lang-field
                  data-da={localize(project.description, "da")}
                  data-en={localize(project.description, "en")}
                  class="project-description font-sans text-base md:text-lg text-muted-foreground leading-relaxed mb-6"
                >
                  {localize(project.description, "da")}
                </p>

                <!-- Project link -->
                <span
                  class="project-link inline-flex items-center gap-2 font-sans text-primary font-medium"
                >
                  <span data-i18n="projects.viewProject">Se projekt</span>

                  <span
                    aria-hidden="true"
                    class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
                  >
                    ↗
                  </span>
                </span>

              </div>
            </a>
          </article>
        ))
      }

    </div>

    {showMoreLink && (
      <div class="mt-16 flex justify-center md:mt-24">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 border-b border-primary pb-1 font-sans font-medium text-primary transition-colors duration-200 hover:border-primary/60 hover:text-primary/70"
        >
          <span data-i18n="projects.seeMore">Se flere projekter</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    )}
  </div>
</section>

<script>
  const initProjectReveal = () => {
    const compactLayout =
      document.querySelector("#projects")?.classList.contains("projects-compact") ??
      false;
    const projectCards =
      document.querySelectorAll<HTMLElement>(
        ".project-card",
      );

    if (projectCards.length === 0) return;

    if ("IntersectionObserver" in window) {
      const revealObserver =
        new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              const card =
                entry.target as HTMLElement;

              card.classList.add("is-visible");

              revealObserver.unobserve(card);
            });
          },
          {
            threshold: 0.15,
            rootMargin: compactLayout
              ? "0px 0px 15% 0px"
              : "0px 0px -8% 0px",
          },
        );

      projectCards.forEach((card) => {
        revealObserver.observe(card);
      });
    } else {
      projectCards.forEach((card) => {
        card.classList.add("is-visible");
      });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initProjectReveal,
    );
  } else {
    initProjectReveal();
  }
</script>