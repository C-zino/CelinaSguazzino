---
import { projects } from "../data/projects";

const localize = (value, language = "da") => {
  if (typeof value === "string") return value;
  return value?.[language] ?? value?.da ?? "";
};
---

<section id="projects" class="bg-secondary/30">
  <div class="section-container">

    <h3 class="section-header reveal-section" data-i18n="projects.heading">
      udvalgte projekter
    </h3>

    <div class="flex flex-col gap-16 md:gap-24">

      {
        projects.map((project, index) => (
          <article
            class="project-card font-sans"
            style={{ transitionDelay: `${index * 120}ms` }}
          >
            <a
              href={`/project/${project.slug}`}
              class="group grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center"
            >

              <!-- Project image -->
              <div
                class="project-image overflow-hidden bg-transparent"
              >
                <img
                  src={project.image}
                  alt={project.title}
                  width="1024"
                  height="768"
                  loading="lazy"
                  class="w-full h-auto object-contain aspect-[4/3] transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                />
              </div>

              <!-- Project information -->
              <div class="project-info flex flex-col font-sans">

                <!-- Category + year -->
                <div
                  class="project-meta flex items-center gap-3 text-sm font-sans text-muted-foreground mb-4"
                >
                  <span
                    data-lang-field
                    data-da={localize(project.category, "da")}
                    data-en={localize(project.category, "en")}
                  >
                    {localize(project.category, "da")}
                  </span>

                  <span class="text-muted-foreground/40">
                    ·
                  </span>

                  <span
                    data-lang-field
                    data-da={localize(project.year, "da")}
                    data-en={localize(project.year, "en")}
                  >
                    {localize(project.year, "da")}
                  </span>
                </div>

                <!-- Tags -->
                {project.tags && project.tags.length > 0 && (
                  <div
                    class="project-tags mb-4 flex flex-wrap gap-3 font-sans"
                  >
                    {project.tags.map((tag) => (
                      <span
                        data-lang-field
                        data-da={localize(tag, "da")}
                        data-en={localize(tag, "en")}
                        class="inline-flex items-center rounded-full bg-secondary/70 px-3 py-1 text-sm font-sans font-medium text-secondary-foreground transition-colors duration-300"
                      >
                        {localize(tag, "da")}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Project title -->
                <h4
                  class="project-title font-sans text-3xl md:text-4xl lg:text-5xl font-medium text-foreground mb-4 transition-colors duration-300 group-hover:text-primary"
                >
                  {project.title}
                </h4>

                <!-- Description -->
                <p
                  data-lang-field
                  data-da={localize(project.description, "da")}
                  data-en={localize(project.description, "en")}
                  class="project-description font-sans text-base md:text-lg text-muted-foreground leading-relaxed mb-6"
                >
                  {localize(project.description, "da")}
                </p>

                <!-- Project link -->
                <span
                  class="project-link inline-flex items-center gap-2 font-sans text-primary font-medium"
                >
                  <span data-i18n="projects.viewProject">Se projekt</span>

                  <span
                    aria-hidden="true"
                    class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
                  >
                    ↗
                  </span>
                </span>

              </div>
            </a>
          </article>
        ))
      }

    </div>
  </div>
</section>

<script>
  const initProjectReveal = () => {
    const projectCards =
      document.querySelectorAll<HTMLElement>(
        ".project-card",
      );

    if (projectCards.length === 0) return;

    if ("IntersectionObserver" in window) {
      const revealObserver =
        new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              const card =
                entry.target as HTMLElement;

              card.classList.add("is-visible");

              revealObserver.unobserve(card);
            });
          },
          {
            threshold: 0.15,
            rootMargin: "0px 0px -8% 0px",
          },
        );

      projectCards.forEach((card) => {
        revealObserver.observe(card);
      });
    } else {
      projectCards.forEach((card) => {
        card.classList.add("is-visible");
      });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initProjectReveal,
    );
  } else {
    initProjectReveal();
  }
</script>