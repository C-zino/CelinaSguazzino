---
const links = [
  { key: "nav.about", fallback: "om", href: "/#about" },
  { key: "nav.projects", fallback: "projekter", href: "/#projects" },
  { key: "nav.contact", fallback: "kontakt", href: "/#contact" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-8 py-6">
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="font-display text-2xl md:text-3xl text-foreground hover:text-primary transition-colors tracking-tight"
      >
        celina sguazzino
      </a>

      <div class="flex items-center gap-8 md:gap-12 text-sm tracking-wide">
        {
          links.map((link) => (
            <a href={link.href} class="nav-link">
              <span data-i18n={link.key}>{link.fallback}</span>
            </a>
          ))
        }
        <div class="flex items-center gap-2 border-l border-black/20 pl-4">
          <button
            type="button"
            data-language-option="da"
            class="cursor-pointer text-sm font-semibold text-foreground transition-colors"
          >
            DA
          </button>
          <span class="text-muted-foreground/50">/</span>
          <button
            type="button"
            data-language-option="en"
            class="cursor-pointer text-sm text-muted-foreground transition-colors"
          >
            EN
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>
